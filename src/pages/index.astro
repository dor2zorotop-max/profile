---
import Layout from '../components/Layout.astro'; import {profile} from '../data/profile'; import {copy} from '../data/content'; import type {Locale} from '../data/site'; import {projects} from '../data/projects'; import {existsSync} from 'node:fs'; import '../styles/global.css';
const locale: Locale='en'; const t=copy[locale]; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const portrait=profile.portrait.startsWith('/')&&existsSync(`public${profile.portrait}`)?profile.portrait:'';
---
<Layout locale={locale} current="profile" title={t.profile}><div class="eyebrow">Academic Profile</div><div class="profile-intro"><div><h1>{profile.name||'[Your Name]'}</h1>{profile.title[locale]&&<p>{profile.title[locale]}</p>}{profile.affiliation[locale]&&<p>{profile.affiliation[locale]}</p>}{profile.location[locale]&&<p>{profile.location[locale]}</p>}{profile.bio[locale]&&<p>{profile.bio[locale]}</p>}</div>{portrait&&<img src={`${base}${portrait}`} alt={profile.name||'Portrait'} />}</div><h2>{t.interests}</h2>{profile.researchInterests[locale].length?<div class="links">{profile.researchInterests[locale].map(i=><span>{i}</span>)}</div>:<p class="empty">{t.englishPending}</p>}<h2>{t.selectedWork}</h2>{projects.map(project=><div class="row"><div class="year">{project.year}</div><div><h3><a href={`${base}/projects/${project.slug}`}>{project.title[locale]}</a></h3>{project.summary[locale]&&<p>{project.summary[locale]}</p>}</div></div>)}<div class="links profile-links">{profile.email&&<a href={`mailto:${profile.email}`}>{t.email}</a>}{profile.website&&<a href={profile.website}>{t.website}</a>}{profile.github&&<a href={profile.github}>{t.github}</a>}</div></Layout>
<style>.profile-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(120px,220px);gap:40px;align-items:start}.profile-intro:not(:has(img)){display:block}.profile-intro img{width:100%;height:auto;object-fit:cover}.profile-links{margin-top:48px}@media(max-width:700px){.profile-intro{grid-template-columns:1fr}.profile-intro img{max-width:220px}}</style>
