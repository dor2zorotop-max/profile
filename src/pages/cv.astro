---
import Layout from '../components/Layout.astro'; import {copy} from '../data/content'; import type {Locale} from '../data/site'; import {existsSync} from 'node:fs'; import '../styles/global.css';
const locale: Locale='en'; const t=copy[locale]; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const cv=existsSync('public/cv/cv-en.pdf')?`${base}/cv/cv-en.pdf`:'';
---
<Layout locale={locale} current="cv" title={t.cv}><div class="page-header"><h1>{t.cv}</h1></div>{cv?<div class="links"><a href={cv}>{t.openCv}</a><a href={cv} download>{t.downloadCv}</a></div>:<p class="empty">{t.cvAvailable}</p>}</Layout>
