---
import Layout from '../../../components/Layout.astro'; import ProjectMedia from '../../../components/ProjectMedia.astro'; import {projects} from '../../../data/projects'; import {publications} from '../../../data/publications'; import {copy} from '../../../data/content'; import type {Locale} from '../../../data/site'; import '../../../styles/global.css';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props; const locale: Locale='zh'; const t=copy[locale]; const projectPublications=publications[locale].filter(item=>item.projectSlug===project.slug);
---
<Layout locale={locale} current="projects" title={project.title[locale]}><div class="page-header"><h1>{project.title[locale]}</h1><p>{project.period[locale]}</p></div><div class="project-meta"><span>{t.type}: {project.type[locale]}</span><span>{t.role}: {project.role[locale]}</span></div><h2>{t.overview}</h2><p>{project.overview[locale]}</p><h2>{t.technicalWork}</h2><p>{project.technicalWork[locale]}</p><ul>{project.bullets[locale].map(item=><li>{item}</li>)}</ul>{project.result[locale]&&<><h2>{t.result}</h2><p>{project.result[locale]}</p></>}<ProjectMedia project={project} locale={locale} labels={t}/>{projectPublications.length>0&&<><h2>{t.selectedOutputs}</h2>{projectPublications.map(p=><div class="row"><div class="year">{p.status}</div><div><h3>{p.title}</h3><p>{p.venue} · {p.contribution}</p></div></div>)}</>}</Layout>
