---
import Layout from '../../components/Layout.astro'; import {copy} from '../../data/content'; import type {Locale} from '../../data/site'; import {publications} from '../../data/publications'; import '../../styles/global.css';
const locale: Locale='zh'; const t=copy[locale];
---
<Layout locale={locale} current="publications" title={t.publications}><div class="page-header"><h1>{t.publications}</h1></div>{publications[locale].length?publications[locale].map(p=><div class="row"><div class="year">{p.year||'—'}</div><div><h3>{p.title}</h3><p>{p.venue}</p><p>{p.status} · {p.contribution}</p></div></div>):<p class="empty">{t.empty}</p>}</Layout>
