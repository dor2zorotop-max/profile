---
import Layout from '../../components/Layout.astro'; import {copy} from '../../data/content'; import type {Locale} from '../../data/site'; import {skills} from '../../data/skills'; import '../../styles/global.css';
const locale: Locale='zh'; const t=copy[locale];
---
<Layout locale={locale} current="skills" title={t.skills}><div class="page-header"><h1>{t.skills}</h1></div>{skills[locale].length?skills[locale].map(group=><div class="row"><div class="year">{group.title}</div><div><div class="links">{group.items.map(item=><span>{item}</span>)}</div>{group.description&&<p>{group.description}</p>}</div></div>):<p class="empty">{t.empty}</p>}</Layout>
