---
import SEO from './SEO.astro';
import { copy } from '../data/content';
import { profile } from '../data/profile';
import { languages, type Locale } from '../data/site';
const { locale, current, title, backTab } = Astro.props as { locale: Locale; current: string; title?: string; backTab?: string };
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = locale === 'en' ? `${base}/` : `${base}/zh/`;
const name = locale === 'en' ? profile.nameEn : profile.name;
const pathname = Astro.url.pathname.replace(base, '') || '/';
const pathWithoutLocale = pathname.replace(/^\/zh(?=\/|$)/, '') || '/';
const localizedPath = (target: Locale) => target === 'en' ? `${base}${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}` : `${base}/zh${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const primary = [
  { key: 'home', href: home },
];
const isProjectDetail = /^\/projects\/[^/]+/.test(pathWithoutLocale);
const fallbackTab = backTab ?? (isProjectDetail ? 'experience' : '');
const fallbackHref = fallbackTab ? `${home}#${fallbackTab}` : home;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <SEO title={title ? `${title} · ${name || 'Academic Homepage'}` : undefined} description={profile.bio[locale] || t.profile} />
  </head>
  <body>
    <div class="site-frame">
      <header class="site-header">
        <div class="site-header-inner">
          <p class="header-motto">{locale === 'zh' ? '持续投资自我，认真对待每一次博弈' : 'Keep investing in yourself, and take every game seriously.'}</p>
          <nav class="primary-nav" aria-label={locale === 'zh' ? '主导航' : 'Primary navigation'}>
            {primary.map(item => <a class:list={{ active: current === 'profile' }} href={item.href}>{locale === 'zh' ? '首页' : 'Home'}</a>)}
            <span class="language-links">{Object.entries(languages).map(([key, language]) => <a class:list={{ active: locale === key }} href={localizedPath(key as Locale)} aria-label={language.label}>{language.short}</a>)}</span>
          </nav>
          <details class="mobile-menu"><summary>{locale === 'zh' ? '菜单' : 'Menu'}</summary><div class="mobile-menu-panel">{primary.map(item => <a href={item.href}>{locale === 'zh' ? '首页' : 'Home'}</a>)}<span class="language-links">{Object.entries(languages).map(([key, language]) => <a class:list={{ active: locale === key }} href={localizedPath(key as Locale)}>{language.short}</a>)}</span></div></details>
        </div>
      </header>
      <main><slot /></main>
      {current !== 'profile' && <a class="floating-back" data-back-home data-site-base={base || '/'} href={fallbackHref} aria-label={locale === 'zh' ? '返回上一页' : 'Go back'} title={locale === 'zh' ? '返回上一页' : 'Go back'}>←</a>}
    </div>
  </body>
<script is:inline>
  const preserveSection = () => document.querySelectorAll('.language-links a').forEach(link => {
    const target = new URL(link.href);
    target.hash = location.hash;
    link.href = target.href;
  });
  preserveSection();
  window.addEventListener('hashchange', preserveSection);
  document.querySelectorAll('.language-links a').forEach(link => link.addEventListener('click', preserveSection));
  document.querySelectorAll('[data-back-home]').forEach(link => link.addEventListener('click', event => {
    const referrer = document.referrer;
    let sameSite = false;
    if (referrer) {
      try {
        const previous = new URL(referrer);
        const basePath = link.dataset.siteBase.replace(/\/$/, '');
        sameSite = previous.origin === location.origin && (previous.pathname === basePath || previous.pathname.startsWith(`${basePath}/`));
      } catch {}
    }
    if (sameSite && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  }));
  const avoidMediaControls = () => {
    const button = document.querySelector('[data-back-home]');
    if (!button) return;
    const b = button.getBoundingClientRect();
    const overlaps = [...document.querySelectorAll('video')].some(video => {
      const v = video.getBoundingClientRect();
      return v.width > 0 && b.left < v.right && b.right > v.left && b.top < v.bottom && b.bottom > Math.max(v.top, v.bottom - 64);
    });
    button.style.visibility = overlaps ? 'hidden' : '';
  };
  window.addEventListener('scroll', avoidMediaControls, { passive: true });
  window.addEventListener('resize', avoidMediaControls);
  window.addEventListener('load', avoidMediaControls);
</script>
</html>
<style is:global>:focus-visible{outline:2px solid #003f88;outline-offset:3px}@media(prefers-reduced-motion:reduce){*{transition:none!important}}</style>
