---
import type { Locale } from '../data/site';
import { profile } from '../data/profile';
import { research } from '../data/research';
import { projects } from '../data/projects';
import { competitions } from '../data/competitions';
import { industry } from '../data/industry';
import { researchPreviews } from '../data/researchPreviews';

const { locale } = Astro.props as { locale: Locale };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = locale === 'zh'
  ? { biography: '个人简介', interests: '研究方向', experience: '科研经历', competitions: '比赛经历', projects: '项目经历', resume: '简历：', role: '角色', detail: '查看详情 →', documents: '相关材料' }
  : { biography: 'Biography', interests: 'Research Interests', experience: 'Research Experience', competitions: 'Competitions', projects: 'Projects', resume: 'Academic and Professional Experience', role: 'Role', detail: 'View details →', documents: 'Related materials' };
const tabs = [
  { id: 'biography', label: labels.biography },
  { id: 'research', label: labels.interests },
  { id: 'experience', label: labels.experience },
  { id: 'competitions', label: labels.competitions },
  { id: 'projects', label: labels.projects },
];
const portrait = `${base}/media/images/profile-photo.jpg`;
const asset = (path: string) => path.startsWith('/') ? `${base}${path}` : path;
---
<div class="homepage">
  <section class="profile-card" aria-label={locale === 'zh' ? '个人信息' : 'Profile information'}>
    <div class="portrait-column"><img src={portrait} alt={locale === 'zh' ? '洪陈源证件照' : 'Portrait of Chenyuan Hong'} /></div>
    <div class="identity-column"><h1>{locale === 'zh' ? profile.name : profile.nameEn}</h1><p class="member-status">{profile.memberStatus[locale]}</p><span class="degree-label">{profile.degree[locale]}</span><p class="identity-line"><strong>{locale === 'zh' ? '专业' : 'Major'}</strong>{profile.major[locale]}</p></div>
    <div class="contact-column">
      <p><strong>{locale === 'zh' ? '单位' : 'Affiliation'}</strong>{profile.affiliations[locale].map(item => <span>{item}</span>)}</p>
      <p><strong>{locale === 'zh' ? '邮箱' : 'Email'}</strong><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <p><strong>{locale === 'zh' ? '联系电话' : 'Phone'}</strong><a href={`tel:${profile.phone.en.replace(/[^+\d]/g, '')}`}>{profile.phone[locale]}</a></p>
      <p><strong>{locale === 'zh' ? '地址' : 'Addresses'}</strong>{profile.addresses[locale].map(item => <span>{item}</span>)}</p>
      <p><strong>{locale === 'zh' ? '研究方向' : 'Research Interests'}</strong>{profile.researchInterests[locale].map(item => <span>{item}</span>)}</p>
    </div>
  </section>

  <nav class="homepage-tabs" aria-label={locale === 'zh' ? '主页内容' : 'Homepage sections'}>
    {tabs.map((tab, index) => <a href={`#${tab.id}`} data-tab={tab.id} aria-selected={index === 0}>{tab.label}</a>)}
  </nav>

  <div class="homepage-panels">
    <section id="biography" class="homepage-panel" data-panel aria-labelledby="tab-biography"><h2 id="tab-biography">{labels.biography}</h2><p class="lead-copy">{profile.bio[locale]}</p><div class="experience-timeline"><strong>{labels.resume}</strong>{profile.academicExperience[locale].map(item => <div class="timeline-row"><span class="timeline-period">{item.period}</span><span>{item.text}</span></div>)}</div></section>

    <section id="research" class="homepage-panel" data-panel aria-labelledby="tab-research" hidden><h2 id="tab-research">{labels.interests}</h2><div class="research-list">{research[locale].map(item => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>

    <section id="experience" class="homepage-panel" data-panel aria-labelledby="tab-experience" hidden>
      <h2 id="tab-experience">{labels.experience}</h2>
      <div class="research-list project-list">{projects.map(project => {
        const preview = researchPreviews[project.slug];
        const detailUrl = `${base}${locale === 'zh' ? '/zh' : ''}/projects/${project.slug}/`;
        return <article class="research-preview">
          <div class="item-period">{project.period[locale]}</div>
          <h3>{project.title[locale]}</h3>
          <p class="item-role">{labels.role}: {project.role[locale]}</p>
          <div class="research-preview-body">
            <p>{project.summary[locale]}</p>
            <h4>{locale === 'zh' ? '核心技术工作' : 'Core Technical Work'}</h4>
            <p>{preview.work[locale]}</p>
            <figure class="research-preview-image"><img loading="lazy" decoding="async" src={asset(project.heroImage)} alt={(project.heroCaption ?? project.title)[locale]} /></figure>
            <p class="homepage-result"><strong>{locale === 'zh' ? '代表性成果' : 'Representative Results'}</strong>{(preview.result ?? project.result)[locale]}</p>
          </div>
          <div class="research-preview-fade"><a href={detailUrl} aria-label={`${locale === 'zh' ? '查看详情' : 'View Details'}: ${project.title[locale]}`}>{locale === 'zh' ? '查看详情' : 'View Details'}<span aria-hidden="true"> →</span></a></div>
        </article>;
      })}</div>
    </section>
    <section id="competitions" class="homepage-panel" data-panel aria-labelledby="tab-competitions" hidden>
      <h2 id="tab-competitions">{labels.competitions}</h2>
      <div class="research-list competition-list">{competitions[locale].map(item => <article>
        <div class="item-period">{item.period}</div>
        <h3>{item.competition[locale]}</h3>
        {!item.subevents && <p class="competition-award"><strong>{item.track[locale]}</strong> · {item.award[locale]}</p>}
        {item.certificate && <figure class="certificate-preview"><img loading="lazy" src={asset(item.certificate.preview)} alt={item.certificate.alt[locale]} /></figure>}
        {item.subevents ? <div class="competition-subevents">{item.subevents.map(sub => <section class="competition-subitem">
          <h4>{sub.title[locale]}</h4><p class="competition-award"><strong>{sub.award[locale]}</strong></p>
          {sub.certificate && <figure class="certificate-preview"><img loading="lazy" src={asset(sub.certificate.preview)} alt={sub.certificate.alt[locale]} /></figure>}
          <p>{sub.contribution[locale]}</p>
          {sub.images.length > 0 && <div class="competition-images">{sub.images.map(src => <img loading="lazy" src={asset(src)} alt={sub.title[locale]} />)}</div>}
          {sub.videos?.map(video => <figure class="competition-video"><video controls playsinline preload="metadata" poster={asset(video.poster)} aria-label={video.title[locale]}><source src={video.src} type="video/mp4" /></video><figcaption>{video.title[locale]}</figcaption></figure>)}
        </section>)}</div> : <>
          <p>{item.contribution[locale]}</p>
          {item.images.length > 0 && <div class="competition-images">{item.images.map(src => <img loading="lazy" src={asset(src)} alt={item.competition[locale]} />)}</div>}
          {item.videos && <div class="competition-videos">{item.videos.map(video => <figure class="competition-video"><video controls playsinline preload="metadata" poster={asset(video.poster)} aria-label={video.title[locale]}><source src={video.src} type="video/mp4" /></video><figcaption>{video.title[locale]}</figcaption></figure>)}</div>}
        </>}
        {item.related && <p class="related-link"><a href={`${base}${locale === 'zh' ? '/zh' : ''}/projects/reconfigurable-uav/`}>{item.related[locale]} →</a></p>}
      </article>)}</div>
    </section>
    <section id="projects" class="homepage-panel" data-panel aria-labelledby="tab-projects" hidden>
      <h2 id="tab-projects">{labels.projects}</h2>
      <div class="industry-list">{industry[locale].map(item => <article class="industry-item">
        {item.period && <div class="item-period">{item.period}</div>}
        <h3>{item.title}</h3><p class="industry-company">{item.company} · {item.role}</p>
        <div class="industry-description">{(item.paragraphs ?? [item.summary]).map(text => <p>{text}</p>)}</div>
        {!item.paragraphs && item.responsibilities.length > 0 && <><h4>{locale === 'zh' ? '技术工作' : 'Technical Work'}</h4><ul>{item.responsibilities.map(text => <li>{text}</li>)}</ul></>}
        {item.architecture && <div class="industry-architecture"><h4>{locale === 'zh' ? '硬件架构' : 'Hardware Architecture'}</h4><p>{item.architecture.map((line, index) => <span class:list={{ 'architecture-break': line === '↕', 'architecture-last': index === item.architecture!.length - 1 }}>{line}</span>)}</p><small>{locale === 'zh' ? 'Hardware concept / system architecture' : 'Hardware concept / system architecture'}</small></div>}
        {item.images.length > 0 && <div class="industry-images">{item.images.map(src => <img loading="lazy" src={asset(src)} alt={item.title} />)}</div>}
        {item.technologies.length > 0 && <p class="technology-line">{item.technologies.join(' · ')}</p>}
      </article>)}</div>
    </section>
  </div>
</div>
<script is:inline>
  const tabLinks = [...document.querySelectorAll('[data-tab]')];
  const panels = [...document.querySelectorAll('[data-panel]')];
  const valid = new Set(tabLinks.map(link => link.dataset.tab));
  const activate = (id, updateUrl = false) => {
    const next = valid.has(id) ? id : 'biography';
    tabLinks.forEach(link => link.setAttribute('aria-selected', String(link.dataset.tab === next)));
    panels.forEach(panel => { panel.hidden = panel.id !== next; });
    if (updateUrl) history.replaceState(null, '', `#${next}`);
  };
  tabLinks.forEach(link => link.addEventListener('click', event => { event.preventDefault(); activate(link.dataset.tab, true); }));
  window.addEventListener('hashchange', () => activate(location.hash.slice(1)));
  activate(location.hash.slice(1));
</script>
