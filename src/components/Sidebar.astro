---
import { languages, type Locale } from '../data/site';
import { copy } from '../data/content';
import { profile } from '../data/profile';
const { locale, current } = Astro.props as { locale: Locale; current: string };
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = locale === 'en' ? `${base}/` : `${base}/zh/`;
---
<aside class="sidebar" id="mobile-nav">
  <div class="identity"><strong>{locale === 'en' ? profile.nameEn : profile.name}</strong><span>{profile.title[locale]}</span></div>
  <nav aria-label={locale === 'zh' ? '主导航' : 'Primary navigation'}><a class:list={{ active: current === 'profile' }} href={home}>{locale === 'zh' ? '首页' : 'Home'}</a></nav>
  <div class="sidebar-foot"><div class="language-switcher" aria-label={locale === 'zh' ? '语言切换' : 'Language switcher'}>{Object.entries(languages).map(([key, language]) => <a class:list={{ active: locale === key }} href={key === 'en' ? `${base}/` : `${base}/zh/`}>{language.short}</a>)}</div><div class="external">{profile.github && <a href={profile.github}>GitHub</a>}{profile.email && <a href={`mailto:${profile.email}`}>{t.email}</a>}</div></div>
</aside>
